# API base URL used by the frontend bundle.
#
# By default the frontend uses a RELATIVE path `/api`, which is proxied to the
# backend by a Next.js rewrite (see next.config.js). This works on localhost and
# any remote host without hardcoding an IP.
#
# Only set this to an absolute URL if you want the browser to call a different
# origin directly (in which case that origin must allow CORS).
# NEXT_PUBLIC_API_URL=/api
