# Database
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sert_manager
DB_USERNAME=sert_user
DB_PASSWORD=changeme

# Backend
JWT_SECRET=your-secret-key-change-in-production
APP_KEY=base64:your-app-key-here
CACHE_STORE=redis
REDIS_HOST=redis

# PgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=changeme

# Ports (optional, defaults shown)
# BACKEND_PORT=6162
# FRONTEND_PORT=3000
# PGADMIN_PORT=5050

# Frontend -> backend proxy target (internal Docker hostname; no need to change normally).
# The frontend calls /api/* on its own origin and Next.js proxies to this host.
# API_PROXY_TARGET=http://nginx
